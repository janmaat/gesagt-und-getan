---
import Basis from '../layouts/Basis.astro';
---
<Basis titel="Suche" suchbar={false}>
  <h1>Suche</h1>
  <p>Suchen Sie in Versprechen, Parteien und Begriffen. Die Suche läuft ganz in Ihrem Browser; wir sehen nicht, wonach Sie suchen.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="suche"></div>
  <noscript><p>Die Suche braucht JavaScript. Alle Versprechen finden Sie auch auf der Seite „<a href="/versprechen/">Alle Versprechen</a>“.</p></noscript>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({ element: '#suche', showSubResults: true, translations: { placeholder: 'Suchbegriff eingeben', zero_results: 'Keine Treffer für [SEARCH_TERM]' } });
      } else {
        document.getElementById('suche').textContent = 'Der Suchindex wird beim Bauen der Seite erstellt (npm run build).';
      }
    });
  </script>
</Basis>
